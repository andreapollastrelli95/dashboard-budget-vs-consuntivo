		dataType: string
		lineageTag: 683e1d1c-3493-4539-950b-ff73cd4afca8
		summarizeBy: none
		sourceColumn: EntryType

	partition FactActual = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Projects\dashboard-budget-vs-consuntivo\data\model\fact_actual.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"DateKey", Int64.Type}, {"CostCenterKey", Int64.Type}, {"AccountKey", Int64.Type}, {"DocumentNumber", type text}, {"Amount", type number}, {"SignedAmount", type number}, {"Description", type text}, {"Counterparty", type text}, {"EntryType", type text}}, "en-US")
				in
				    Typed

