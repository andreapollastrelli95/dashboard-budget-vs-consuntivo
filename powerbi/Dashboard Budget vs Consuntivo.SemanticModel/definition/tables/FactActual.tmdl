		lineageTag: 9999ceca-df37-43d2-9300-b2ee02b7fb7e

	measure 'Budget Gross Margin %' = DIVIDE ( [Budget Gross Margin], [Budget Revenue] )
		formatString: 0.0%
		displayFolder: 04 Margini
		lineageTag: 26e18ae2-44ba-4554-8762-64567dc8f3c8

	measure 'Gross Margin % Delta pp' = ( [Actual Gross Margin %] - [Budget Gross Margin %] ) * 100
		formatString: #,0.0
		displayFolder: 04 Margini
		lineageTag: 3905072a-2f0a-480e-b6b1-df8bb1a29bab

	measure 'Actual EBITDA' = CALCULATE ( [Actual Signed], Account[AccountType] <> "D&A" )
