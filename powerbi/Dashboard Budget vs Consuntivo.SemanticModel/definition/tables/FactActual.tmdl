		lineageTag: 8c3c531c-48d0-4bdd-8c48-4a7baa75da5a

	measure 'Actual Revenue PY' = CALCULATE ( [Actual Revenue], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
		formatString: #,0
		displayFolder: 02 Ricavi e costi
		lineageTag: 488c26dd-19fd-4dde-8a1f-feae37b6542d

	measure 'Variance €' = [Actual] - [Budget]
		formatString: #,0
		displayFolder: 03 Scostamenti
		lineageTag: 1e272b46-a279-418b-96ff-dc972e6f7101

	measure 'Variance %' = DIVIDE ( [Variance €], ABS ( [Budget] ) )
		formatString: 0.0%
		displayFolder: 03 Scostamenti
		lineageTag: 830db8ef-aecf-4726-886b-d21affb3625e

	measure 'Variance Fav €' =
			SUMX (
			    VALUES ( Account[PLSign] ),
			    ( [Actual] - [Budget] ) * Account[PLSign]
			)
		formatString: #,0
		displayFolder: 03 Scostamenti
		lineageTag: 9ab2a8cd-5677-4481-98a0-14010d82e669

	measure 'Variance Fav %' = DIVIDE ( [Variance Fav €], ABS ( [Budget Signed] ) )
		formatString: 0.0%
		displayFolder: 03 Scostamenti
		lineageTag: c1cef3c6-2787-4064-ad0e-9a003b861a2b

	measure 'Revenue Variance €' = [Actual Revenue] - [Budget Revenue]
		formatString: #,0
		displayFolder: 03 Scostamenti
		lineageTag: f7efb41f-e3fe-4d12-8cca-e484d9948be5

	measure 'Revenue Variance %' = DIVIDE ( [Revenue Variance €], [Budget Revenue] )
		formatString: 0.0%
		displayFolder: 03 Scostamenti
		lineageTag: 6310a44a-9e5c-4c78-bc33-c1b5773cffd8

	measure 'Cost Variance €' = [Actual Cost] - [Budget Cost]
		formatString: #,0
		displayFolder: 03 Scostamenti
		lineageTag: bc490a6a-dae1-446c-89c5-2f1e9a5f8c28

	measure 'Cost Variance %' = DIVIDE ( [Cost Variance €], [Budget Cost] )
		formatString: 0.0%
		displayFolder: 03 Scostamenti
		lineageTag: 5b904fcc-b081-4195-8310-53dbb669803d

	measure 'Variance vs Forecast €' = SUMX ( VALUES ( Account[PLSign] ), ( [Actual] - [Forecast] ) * Account[PLSign] )
		formatString: #,0
		displayFolder: 03 Scostamenti
		lineageTag: ec742601-7a7e-45f6-a6d8-84bb10b53baf

	measure 'Variance Status' =
			VAR _v = [Variance Fav %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Budget] ) && NOT ISBLANK ( [Actual] ), "Non a budget",
			        _v >= 0, "Favorevole",
			        _v >= -0.05, "Attenzione",
			        "Sfavorevole"
			    )
		displayFolder: 03 Scostamenti
		lineageTag: a18e135f-80de-4083-b4fd-3d07222640ed

	measure 'Variance Color' =
			VAR _v = [Variance Fav %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _v ), "#8A94A6",
			        _v >= 0, "#1E8E5A",
			        _v >= -0.05, "#E0A100",
			        "#C0392B"
			    )
		displayFolder: 03 Scostamenti
		lineageTag: b84c42b9-3569-4517-8f20-3afd3fff45b2

	measure 'Actual Gross Margin' = CALCULATE ( [Actual Signed], Account[AccountType] IN { "Revenue", "COGS" } )
		formatString: #,0
		displayFolder: 04 Margini
		lineageTag: 1bcbfc0f-5ab7-4dab-8fb4-296765b45f9c

	measure 'Budget Gross Margin' = CALCULATE ( [Budget Signed], Account[AccountType] IN { "Revenue", "COGS" } )
		formatString: #,0
		displayFolder: 04 Margini
		lineageTag: bc23812a-c4e6-424e-a32f-2b9c1e640b36

	measure 'Actual Gross Margin %' = DIVIDE ( [Actual Gross Margin], [Actual Revenue] )
		formatString: 0.0%
