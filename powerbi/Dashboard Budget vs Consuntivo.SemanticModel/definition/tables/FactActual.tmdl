		displayFolder: 04 Margini
		lineageTag: 74a01bd0-92fb-4d29-a1a9-a4a1f94078ea

	measure 'Actual Operating Margin' = [Actual Signed]
		formatString: #,0
		displayFolder: 04 Margini
		lineageTag: 249d246b-2b0d-4d2f-8f5e-25110f00c770

	measure 'Budget Operating Margin' = [Budget Signed]
		formatString: #,0
		displayFolder: 04 Margini
		lineageTag: 856e112e-15c2-4ea2-856d-5f4bace8decc

	measure 'Forecast Operating Margin' = [Forecast Signed]
		formatString: #,0
		displayFolder: 04 Margini
		lineageTag: 679b8b94-e7d6-43d9-b849-e5f14d68d792

	measure 'Operating Margin Variance €' = [Actual Operating Margin] - [Budget Operating Margin]
		formatString: #,0
		displayFolder: 04 Margini
		lineageTag: ca1ca064-8687-4f58-8e37-c24fabe3c65f

	measure 'Operating Margin Variance %' = DIVIDE ( [Operating Margin Variance €], ABS ( [Budget Operating Margin] ) )
		formatString: 0.0%
		displayFolder: 04 Margini
		lineageTag: 2e3b2935-bee2-4735-98e3-8c152c30723a

	measure 'Actual Operating Margin %' = DIVIDE ( [Actual Operating Margin], [Actual Revenue] )
		formatString: 0.0%
		displayFolder: 04 Margini
		lineageTag: a29eda24-9480-454a-90b0-64416e628ce2

	measure 'Budget Operating Margin %' = DIVIDE ( [Budget Operating Margin], [Budget Revenue] )
		formatString: 0.0%
		displayFolder: 04 Margini
		lineageTag: 689c326c-1fdc-4c31-9216-e51b8df2793d

	measure 'Operating Margin YTD Actual' = CALCULATE ( [Actual Operating Margin], DATESYTD ( 'Calendar'[Date] ) )
		formatString: #,0
		displayFolder: 04 Margini
		lineageTag: 54bda8d6-5050-430c-b176-0e4de7067434

	measure 'Operating Margin YTD Budget' =
			VAR _LastClosed = [Last Actual DateKey]
			RETURN
			    CALCULATE (
			        [Budget Operating Margin],
			        DATESYTD ( 'Calendar'[Date] ),
			        'Calendar'[DateKey] <= _LastClosed
			    )
		formatString: #,0
		displayFolder: 04 Margini
		lineageTag: 48abda38-ada4-49b5-9d4d-42c012d34423

	measure 'Cost Center Result Actual' = [Actual Signed]
		formatString: #,0
		displayFolder: 05 Centri di costo
		lineageTag: 36f32192-b802-479f-bd8a-83af03eb9d17

	measure 'Cost Center Result Budget' = [Budget Signed]
		formatString: #,0
		displayFolder: 05 Centri di costo
		lineageTag: 82fb29e8-1d52-4521-a47e-5f253f8227c6

	measure 'Cost Center Performance €' = [Variance Fav €]
		formatString: #,0
		displayFolder: 05 Centri di costo
		lineageTag: 23d6ef87-dcdc-47ee-804c-981b36f15a8c

	measure 'Cost Center Performance %' = DIVIDE ( [Variance Fav €], ABS ( [Cost Center Result Budget] ) )
		formatString: 0.0%
		displayFolder: 05 Centri di costo
		lineageTag: d1993781-eb7e-4bc1-8d8a-a64ad411cb7a

	measure 'Budget Consumed %' = DIVIDE ( [Actual Cost], [Budget Cost] )
		formatString: 0.0%
		displayFolder: 05 Centri di costo
		lineageTag: 186d6868-e32f-4a58-891e-1724bdc9fc2e

	measure 'Budget Consumed Full Year %' =
			DIVIDE (
			    [Actual Cost],
			    CALCULATE ( [Budget Cost], DATESYTD ( ENDOFYEAR ( 'Calendar'[Date] ) ) )
			)
		formatString: 0.0%
		displayFolder: 05 Centri di costo
		lineageTag: 460a38f5-02f9-4bf5-a7b0-5672959dd219

	measure 'Controllable Variance €' = CALCULATE ( [Variance Fav €], Account[IsControllable] = TRUE () )
		formatString: #,0
		displayFolder: 05 Centri di costo
		lineageTag: 572b5cda-0bbc-4c98-bbfe-99d4e6f99594

	measure 'Cost Center Rank' =
			IF (
			    HASONEVALUE ( CostCenter[CostCenterName] ),
			    RANKX ( ALLSELECTED ( CostCenter[CostCenterName] ), [Cost Center Performance %], , ASC, DENSE )
			)
		formatString: #,0
		displayFolder: 05 Centri di costo
		lineageTag: 47d27b97-7c46-49a2-bac3-7dd62ca3a74f

	measure 'Cost Centers Over Budget' =
			COUNTROWS (
			    FILTER ( VALUES ( CostCenter[CostCenterName] ), [Cost Center Performance %] < -0.05 )
			)
		formatString: #,0
		displayFolder: 05 Centri di costo
		lineageTag: 1d81d03c-10de-448a-9c6d-45fe54e160cb

	measure 'FTE Actual' =
			AVERAGEX (
			    VALUES ( 'Calendar'[YearMonth] ),
			    CALCULATE ( SUM ( FactHeadcount[FTE] ), Scenario[ScenarioName] = "Actual" )
			)
		formatString: #,0.0
		displayFolder: 06 Organico
		lineageTag: 821361cc-4e2c-4991-87c9-eb94c173d26b

	measure 'FTE Budget' =
			AVERAGEX (
			    VALUES ( 'Calendar'[YearMonth] ),
			    CALCULATE ( SUM ( FactHeadcount[FTE] ), Scenario[ScenarioName] = "Budget" )
			)
		formatString: #,0.0
		displayFolder: 06 Organico
		lineageTag: c606bdc4-2f98-4fd1-89c7-1d57c0ff215a

	measure 'FTE Variance' = [FTE Actual] - [FTE Budget]
		formatString: #,0.0
		displayFolder: 06 Organico
		lineageTag: 51eb6a08-37d1-4acd-a7ef-2d6191834469

	measure 'Personnel Cost Actual' = CALCULATE ( [Actual], Account[PLGroup] = "Costo del personale" )
		formatString: #,0
		displayFolder: 06 Organico
		lineageTag: aae71ec2-3d9f-40b9-92b0-9d119a505cf9

	measure 'Personnel Cost Budget' = CALCULATE ( [Budget], Account[PLGroup] = "Costo del personale" )
		formatString: #,0
		displayFolder: 06 Organico
		lineageTag: c97ce8cf-3a75-4646-8fa5-ca4eadbf49d8

	measure 'Cost per FTE Actual' = DIVIDE ( [Personnel Cost Actual], [FTE Actual] ) * DIVIDE ( 12, DISTINCTCOUNT ( 'Calendar'[YearMonth] ) )
		formatString: #,0.0
		displayFolder: 06 Organico
		lineageTag: ef563ee7-c2a2-4439-8f0a-47951b7203e8

	measure 'Full Year Budget' = CALCULATE ( [Budget Signed], DATESYTD ( ENDOFYEAR ( 'Calendar'[Date] ) ) )
		formatString: #,0
		displayFolder: 07 Forecast
		lineageTag: 1fccda67-5743-41b6-b0ea-f0859bb5c3b9

	measure 'Full Year Forecast' = CALCULATE ( [Forecast Signed], DATESYTD ( ENDOFYEAR ( 'Calendar'[Date] ) ) )
		formatString: #,0
		displayFolder: 07 Forecast
		lineageTag: d6ccc7b3-0760-4de5-aab7-f57736fb44c1

	measure 'Full Year Landing vs Budget €' = [Full Year Forecast] - [Full Year Budget]
		formatString: #,0
		displayFolder: 07 Forecast
		lineageTag: 522e6098-9d82-4185-bc39-bbe761f8c8a6

	measure 'Forecast Accuracy %' = 1 - ABS ( DIVIDE ( [Actual Signed] - [Forecast Signed], [Forecast Signed] ) )
		formatString: 0.0%
		displayFolder: 07 Forecast
		lineageTag: fa3669f3-0b73-41b2-be97-324887cd02bb

	measure 'Actual + Forecast Remaining' =
			VAR _LastClosed = [Last Actual DateKey]
			RETURN
			    CALCULATE ( [Actual Signed], 'Calendar'[DateKey] <= _LastClosed )
			        + CALCULATE ( [Forecast Signed], 'Calendar'[DateKey] > _LastClosed )
		formatString: #,0
		displayFolder: 07 Forecast
		lineageTag: b79af6d0-96c2-4a8c-87c0-abc98af507ba

	measure 'Management Comment Summary' =
			VAR _Y = MAX ( 'Calendar'[Year] )
			VAR _M = MAX ( 'Calendar'[Month] )
			RETURN
			    CALCULATE (
			        CONCATENATEX (
			            ManagementComment,
			            ManagementComment[CommentText],
			            UNICHAR ( 10 ) & UNICHAR ( 10 ),
			            ManagementComment[Priority], ASC
			        ),
			        ManagementComment[Year] = _Y,
			        ManagementComment[Month] = _M,
			        ManagementComment[CommentType] IN { "Sintesi", "Scostamento negativo", "Scostamento positivo", "Forecast" }
			    )
		displayFolder: 08 Commenti
		lineageTag: db0da972-252f-4cac-80ee-657740bfba43

	measure 'Management Comment Cost Center' =
			VAR _Y = MAX ( 'Calendar'[Year] )
			VAR _M = MAX ( 'Calendar'[Month] )
			VAR _CC = SELECTEDVALUE ( CostCenter[CostCenterKey] )
			RETURN
			    CALCULATE (
			        CONCATENATEX ( ManagementComment, ManagementComment[CommentText], UNICHAR ( 10 ) ),
			        ManagementComment[Year] = _Y,
			        ManagementComment[Month] = _M,
			        ManagementComment[CostCenterKey] = _CC
			    )
		displayFolder: 08 Commenti
		lineageTag: 3b0c4576-82ed-44dd-8a03-5662d5f7023e

	measure 'Dynamic Commentary' =
			VAR _Rev   = [Actual Revenue]
			VAR _RevV  = [Revenue Variance %]
			VAR _OM    = [Actual Operating Margin]
			VAR _OMB   = [Budget Operating Margin]
			VAR _GMpp  = [Gross Margin % Delta pp]
			VAR _Worst =
			    TOPN ( 1, VALUES ( CostCenter[CostCenterName] ), [Variance Fav €], ASC )
			VAR _WorstName = MAXX ( _Worst, CostCenter[CostCenterName] )
			VAR _WorstVar  = MINX ( _Worst, [Variance Fav €] )
			VAR _Best =
			    TOPN ( 1, VALUES ( CostCenter[CostCenterName] ), [Variance Fav €], DESC )
			VAR _BestName = MAXX ( _Best, CostCenter[CostCenterName] )
			VAR _BestVar  = MAXX ( _Best, [Variance Fav €] )
			RETURN
			    "Ricavi € " & FORMAT ( _Rev, "#,0" ) & " ("
			        & FORMAT ( _RevV, "+0.0%;-0.0%" ) & " vs budget), margine lordo "
			        & FORMAT ( _GMpp, "+0.0;-0.0" ) & " pp. "
			        & "Risultato operativo € " & FORMAT ( _OM, "#,0" ) & " contro € " & FORMAT ( _OMB, "#,0" )
			        & " a budget. "
			        & "Scostamento peggiore: " & _WorstName & " (€ " & FORMAT ( _WorstVar, "#,0" ) & "); "
			        & "migliore: " & _BestName & " (€ " & FORMAT ( _BestVar, "+#,0" ) & ")."
		displayFolder: 08 Commenti
		lineageTag: cca26fba-b28a-4f3c-a8b0-d209a63f1221

	measure 'Selected Period' = "Gen - " & FORMAT ( MAX ( 'Calendar'[Date] ), "mmm yyyy" )
		displayFolder: 09 UI
		lineageTag: 97ab72e1-7a4e-49a2-babd-6b0cfffbd467

	measure 'Variance Arrow' =
			VAR _v = [Variance Fav €]
			RETURN IF ( ISBLANK ( _v ), BLANK (), IF ( _v >= 0, "▲", "▼" ) )
		displayFolder: 09 UI
		lineageTag: e6670490-596b-444d-9075-2e0ec540fba8

